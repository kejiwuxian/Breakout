# .env.example  (copy to .env and fill in; never commit .env)
USE_CACHED_STREAM=True      # replay data/cache/, no network on the trigger path
                            # set False to subscribe to live GCN / Hopskotch channels
SCENARIO=scenario_a_galactic_ccsn
LCOGT_DRY_RUN=True          # build the RequestGroup JSON, do not submit

# Grok Voice (Make it Legendary requires Grok Voice or Imagine)
VOICE_MODE=live             # live | cached (pre-rendered clips) | off
XAI_VOICE_MODEL=grok-voice-latest   # realtime model alias (grok-voice-3.0)
XAI_TTS_VOICE=eve           # list voices: GET https://api.x.ai/v1/tts/voices

# keys: only the offline build, live mode and voice use them
ADS_API_TOKEN=              # NASA ADS, literature/build_index.py
XAI_API_KEY=                # Grok API: build_index.py, voice/ (server side only)
GCN_CLIENT_ID=              # GCN Kafka live ingest (SNEWS2, IceCube, classic SNEWS, pre-SN)
GCN_CLIENT_SECRET=
SUBSCRIBE_ICECUBE_TEST=False  # also listen to IceCube gold/bronze *test* Kafka topic
HOP_USERNAME=               # optional SCiMMA Hopskotch (snews2.alert); needs `hop` package
HOP_PASSWORD=
HOP_SNEWS_TOPIC=kafka://kafka.scimma.org/snews2.alert
LCOGT_API_TOKEN=            # LCO observe API, only when LCOGT_DRY_RUN=False
LCOGT_PROPOSAL=             # LCO proposal id for actions/lcogt.py

# Community alerts (scientists / enthusiasts → their instruments)
NOTIFY_DRY_RUN=True         # False = POST ranked-candidate JSON to registered webhooks
SMTP_HOST=                  # optional; email stays dry-run without SMTP

# Live channels when USE_CACHED_STREAM=False:
#   gcn.notices.snews2.coincidence
#   gcn.notices.icecube.gold_bronze_track_alerts
#   gcn.notices.presn.kamland_superk
#   gcn.classic.text.SNEWS
#   (+ hop snews2.alert when HOP_* set)
# Localization: DiffPointing from detector times; Super-K / IceCube pointing;
# external healpix_url when a real map URL is present.

# run
uvicorn backend.app:app --reload
npm --prefix frontend run dev
