# .env.example  (copy to .env and fill in; never commit .env)
USE_CACHED_STREAM=True      # offline capability: fixtures under data/cache/
                            # does NOT auto-play — use Replay / POST /scenario/.../start
                            # set False to subscribe to live GCN / Hopskotch channels
SCENARIO=scenario_a_galactic_ccsn   # which cache to use when you manually Run a scenario
# BREAKOUT_AUTOSTART=1      # opt-in only: auto-replay SCENARIO on startup (default: off)
# BREAKOUT_DISABLE_AUTOSTART=1  # legacy / tests: also skips opt-in autostart
LCOGT_DRY_RUN=True          # build the RequestGroup JSON, do not submit

# Grok Voice (Make it Legendary requires Grok Voice or Imagine)
VOICE_MODE=live             # live | cached (pre-rendered clips) | off
XAI_VOICE_MODEL=grok-voice-latest   # realtime model alias (grok-voice-3.0)
XAI_TTS_VOICE=eve           # list voices: GET https://api.x.ai/v1/tts/voices

# keys: only the offline build, live mode and voice use them
ADS_API_TOKEN=              # NASA ADS, literature/build_index.py
XAI_API_KEY=                # Grok API: build_index.py, voice/ (server side only)
GCN_CLIENT_ID=              # NASA GCN: IceCube tracks/cascades, Super-K, classic SNEWS
GCN_CLIENT_SECRET=
SUBSCRIBE_ICECUBE_TEST=False  # also listen to IceCube gold/bronze *test* Kafka topic
HOP_USERNAME=               # optional SCiMMA Hopskotch (snews2.alert); needs `hop` package
HOP_PASSWORD=
HOP_SNEWS_TOPIC=kafka://kafka.scimma.org/snews2.alert
LCOGT_API_TOKEN=            # LCO observe API, only when LCOGT_DRY_RUN=False
LCOGT_PROPOSAL=             # LCO proposal id for actions/lcogt.py

# Community alerts (scientists / enthusiasts → their instruments)
NOTIFY_DRY_RUN=True         # False = POST ranked-candidate JSON to registered webhooks
SMTP_HOST=                  # optional; email stays dry-run without SMTP

# Live channels when USE_CACHED_STREAM=False:
#   gcn.notices.icecube.gold_bronze_track_alerts
#   gcn.classic.text.ICECUBE_CASCADE
#   gcn.notice.superk.sn_alert
#   gcn.classic.text.SNEWS
#   (+ hop snews2.alert when HOP_* set)
# Reserved pre-SN / unverified SNEWS2 JSON topics are not subscribed by default.
# Test/injection/retraction notices never trigger science ranking or notification.
# Localization: DiffPointing from detector times; Super-K / IceCube pointing;
# external healpix_url when a real map URL is present.

# Cold start is idle. With USE_CACHED_STREAM=True, live ingestion is disabled;
# the UI labels demo mode. Replay controls remain available.

# Phase 2 flags: all False by default; the MVP runs with every one off
DROID_ENABLED=False
CONVEX_ENABLED=False
APIFY_ENABLED=False
TIGER_ENABLED=False

# Phase 2 keys, read only when the matching flag is True
FACTORY_API_KEY=                   # Factory Droid SDK
CONVEX_URL=                        # Convex deployment URL for convex_sync.py
CONVEX_DEPLOY_KEY=                 # Convex deploy key, admin auth for writes
APIFY_TOKEN=                       # Apify API token
APIFY_ACTOR_ID=                    # <apify-username>/breakout-star-literature
TIGER_DATABASE_URL=                # postgres://user:pass@host:port/dbname

# frontend/.env.local (written by npx convex dev, gitignored)
# VITE_CONVEX_URL=

# Public URL / Cloudflare tunnel (production demo at https://supernova.lylinks.com)
# Local defaults stay on http://127.0.0.1:8000 unless you set production mode.
# BREAKOUT_PUBLIC_BASE_URL=https://supernova.lylinks.com
# PUBLIC_BASE_URL=https://supernova.lylinks.com          # alias
# ENV=production                                         # or BREAKOUT_PUBLIC=1
# BREAKOUT_SERVE_FRONTEND=1                              # serve frontend/dist from FastAPI
# CLOUDFLARE_TUNNEL_TOKEN=                               # Zero Trust tunnel token — NEVER commit
# Public start (builds frontend if needed, uvicorn + cloudflared):
#   bash scripts/run_public.sh

# Local run (do not leave these uncommented — tools that source .env would execute them):
#   uvicorn backend.app:app --reload
#   npm --prefix frontend run dev
# Or: bash scripts/run_public.sh
